  "productDetails": [
    {
      "type": "image",
      "sectionTitle": {
        "zh": "两座球门，安排对踢",
        "en": "Two goals for a small game"
      },
      "image": "https://www.yaoshuntoys.com/media/products-q92/6643/1fec4b7208f9.webp",
      "text": {
        "zh": "双球门可以相对摆放，用来组织小范围足球游戏，也可以把其中一个球门作为单独练习射门的目标。场地大小和球门间距可按实际活动空间安排。",
        "en": "Place the two goals opposite each other for a small football game, or use one as a shooting target. Set the distance between them to suit the available play area."
      }
    },
    {
      "type": "image",
      "sectionTitle": {
        "zh": "两座92 × 48 × 60 cm球门",
        "en": "Two 92 × 48 × 60 cm goals"
      },
      "image": "https://www.yaoshuntoys.com/media/products-q92/6643/86c28de1aa14.webp",
      "text": {
        "zh": "每座球门宽92 cm、深48 cm、高60 cm。组件列有27 cm短管8根、43 cm长管12根，配直通接头8个、转角接头12个和球网2张，可在装配前逐项核对。",
        "en": "Each goal is 92 cm wide, 48 cm deep and 60 cm high. Components shown are eight 27 cm tubes, twelve 43 cm tubes, eight straight connectors, twelve corner connectors and two nets."
      }
    },
    {
      "type": "image",
      "sectionTitle": {
        "zh": "配球、球网、打气筒与地钉",
        "en": "Ball, nets, pump and stakes"
      },
      "image": "https://www.yaoshuntoys.com/media/products-q92/6643/7bfe5aa38c3b.webp",
      "text": {
        "zh": "另配直径16 cm足球一只、长16 cm打气筒一支及地钉8根。盒面标注3岁及以上，彩盒宽44 cm、厚6.5 cm、高34.5 cm。",
        "en": "The set also shows one 16 cm football, one 16 cm pump and eight stakes. The package is marked ages 3+. Its color box is 44 cm wide, 6.5 cm deep and 34.5 cm high."
      }
    }
  ],
