  "productDetails": [
    {
      "type": "image",
      "sectionTitle": {
        "zh": "投球口与套圈目标分开设置",
        "en": "Separate throwing and ring-toss targets"
      },
      "image": "https://www.yaoshuntoys.com/media/products-q92/LYB008H/e2c1313f0b9d.webp",
      "text": {
        "zh": "漂浮支架带四个独立投球口，两侧还有套圈挂钩。可以把不同目标分成几轮，轮流投球或套圈，不必把所有配件同时投入游戏。",
        "en": "The floating frame has four separate target openings and side ring-toss hooks. Split the targets into rounds and take turns with the balls and rings."
      }
    },
    {
      "type": "image",
      "sectionTitle": {
        "zh": "三类投掷配件",
        "en": "Three types of throwing pieces"
      },
      "image": "https://www.yaoshuntoys.com/media/products-q92/LYB008H/62e6e6ea2511.webp",
      "text": {
        "zh": "资料列有三个篮球、两个橄榄球和四个套圈，另配一个手动打气筒。球与套圈的形状不同，可以分别练习向投球口和挂钩瞄准。",
        "en": "The listed accessories are three basketballs, two American footballs, four rings and one hand pump. Use the different shapes for aiming at the openings and hooks."
      }
    },
    {
      "type": "image",
      "sectionTitle": {
        "zh": "泳池游戏后收齐小配件",
        "en": "Collect the pieces after pool play"
      },
      "image": "https://www.yaoshuntoys.com/media/products-q92/LYB008H/884919163dea.webp",
      "text": {
        "zh": "这款为三合一水上运动组合，采用40.2 × 29.4 × 14 cm手提盒包装。使用后分别收齐球、套圈和打气筒；水上游戏需有人照看。",
        "en": "This 3-in-1 pool set comes in a 40.2 × 29.4 × 14 cm carry box. Collect the balls, rings and pump separately after play. Pool games require supervision."
      }
    }
  ],
