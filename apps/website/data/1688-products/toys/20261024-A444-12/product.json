  "productDetails": [
    {
      "type": "image",
      "sectionTitle": {
        "zh": "纯粉色的公主游戏屋",
        "en": "A solid-pink princess playhouse"
      },
      "image": "https://www.yaoshuntoys.com/media/products-q92/A444-12/8ba5dbd1e5d2.webp",
      "text": {
        "zh": "纯粉色屋顶与房屋造型组成这款公主主题小屋。可以围绕门口安排迎接客人、照顾玩偶等过家家情节，具体游戏由孩子自己决定。",
        "en": "A solid-pink roof and house shape form this princess-themed playhouse. The doorway can become the setting for welcoming visitors or looking after dolls, with the story left to the players."
      }
    },
    {
      "type": "image",
      "sectionTitle": {
        "zh": "先量好位置，再搭建",
        "en": "Measure the space before assembly"
      },
      "image": "https://www.yaoshuntoys.com/media/products-q92/A444-12/d2cc87353989.webp",
      "text": {
        "zh": "搭建后的尺寸为120 × 100 × 130 cm。摆放前先量好游戏区，给门口进出留出位置；套装随附组装说明书，可按说明核对部件和搭建顺序。",
        "en": "The assembled dimensions are 120 × 100 × 130 cm. Measure the play area and leave room at the doorway. Assembly instructions are included for checking the parts and order of assembly."
      }
    },
    {
      "type": "image",
      "sectionTitle": {
        "zh": "布艺结构与彩盒包装",
        "en": "Fabric construction and packing"
      },
      "image": "https://www.yaoshuntoys.com/media/products-q92/A444-12/186154b8b5c0.webp",
      "text": {
        "zh": "商品为布艺游戏屋，具体门帘、窗口和接缝可查看细节图。采用43 × 10 × 26 cm彩盒包装；布置场景用到的玩偶或其他陈设不计入本款已列配件。",
        "en": "The detail images show the fabric, doorway, windows and seams. The color box measures 43 × 10 × 26 cm. Dolls or other items used to style a scene are not listed accessories for this model."
      }
    }
  ],
