  "productDetails": [
    {
      "type": "image",
      "sectionTitle": {
        "zh": "上下分开的两种玩法",
        "en": "Football below, basketball above"
      },
      "image": "https://www.yaoshuntoys.com/media/products-q92/2700-3/1ad49b781c67.webp",
      "text": {
        "zh": "上方是篮球圈，下方是足球球门。两种玩法共用一套支架，可以按游戏安排轮流切换，让投篮和射门各有一个明确目标。",
        "en": "The basketball hoop sits above the football goal. Both games use the same frame, with a separate target for shooting a basketball or kicking a football."
      }
    },
    {
      "type": "image",
      "sectionTitle": {
        "zh": "支架高度与底座占地",
        "en": "Height and base footprint"
      },
      "image": "https://www.yaoshuntoys.com/media/products-q92/2700-3/fdd2b9f38841.webp",
      "text": {
        "zh": "资料标注整体高110 cm，底座约59 × 36 cm。摆放时除了底座，还应预留正面的投篮和踢球距离，不要只按底座大小计算活动区。",
        "en": "The listed height is 110 cm and the base measures approximately 59 × 36 cm. Plan space for shooting and kicking in front, in addition to the base footprint."
      }
    },
    {
      "type": "image",
      "sectionTitle": {
        "zh": "3岁及以上，彩盒包装",
        "en": "Ages 3+, in a color box"
      },
      "image": "https://www.yaoshuntoys.com/media/products-q92/2700-3/f5ace12e6a2b.webp",
      "text": {
        "zh": "盒面适龄标注为3岁及以上。单品包装尺寸37 × 7 × 26 cm，盒面同时展示篮球与足球玩法，便于识别这款二合一配置。",
        "en": "The package is marked for ages 3 and above. Its color box measures 37 × 7 × 26 cm and shows both basketball and football play to identify the 2-in-1 configuration."
      }
    }
  ],
