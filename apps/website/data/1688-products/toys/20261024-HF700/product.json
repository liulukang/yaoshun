  "productDetails": [
    {
      "type": "image",
      "sectionTitle": {
        "zh": "泳池里的投篮目标",
        "en": "A basketball target for pool play"
      },
      "image": "https://www.yaoshuntoys.com/media/products-q92/HF700/c855be12737b.webp",
      "text": {
        "zh": "水上篮球架把投篮游戏带到泳池场景中。可以轮流投篮，或按命中次数安排简单比赛；它是游戏用具，水上活动仍需有人照看。",
        "en": "This basketball frame provides a shooting target for pool play. Take turns shooting or count successful baskets for a simple game. It is a play item, and pool activities still require supervision."
      }
    },
    {
      "type": "image",
      "sectionTitle": {
        "zh": "篮板、支架与底座",
        "en": "Backboard, frame and base"
      },
      "image": "https://www.yaoshuntoys.com/media/products-q92/HF700/c0982445aed0.webp",
      "text": {
        "zh": "篮板宽30 cm，整体高63.5 cm，底座深43 cm，球直径4英寸。尺寸图把篮板宽度、整体高度和底座深度分别标出，便于安排使用位置。",
        "en": "The backboard is 30 cm wide, overall height is 63.5 cm and base depth is 43 cm. The ball is 4 inches in diameter. The dimension image separates these measurements for placement reference."
      }
    },
    {
      "type": "image",
      "sectionTitle": {
        "zh": "篮球与打气筒",
        "en": "Ball and pump"
      },
      "image": "https://www.yaoshuntoys.com/media/products-q92/HF700/fa0d8b14413e.webp",
      "text": {
        "zh": "配图展示篮球与打气筒，盒面品牌为BEST BOY，型号HF700。单品彩盒尺寸45.5 × 8.8 × 30 cm，补气和收纳时可把小配件一起保管。",
        "en": "The product images show the basketball and pump. The package is marked BEST BOY, model HF700, and the color box measures 45.5 × 8.8 × 30 cm. Keep the smaller pieces together between uses."
      }
    }
  ],
