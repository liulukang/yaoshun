  "productDetails": [
    {
      "type": "image",
      "sectionTitle": {
        "zh": "遥控之外，还能触摸互动",
        "en": "Remote control and touch interaction"
      },
      "image": "https://www.yaoshuntoys.com/media/products-q92/9901/b418ab526f2d.webp",
      "text": {
        "zh": "智能狗支持远程遥控、触摸感应与编程指令。可以先用遥控器熟悉基本动作，再把动作编成顺序，观察机器狗如何完成这一段指令。",
        "en": "The dog supports remote control, touch sensing and programmable commands. Start with the controller, then arrange actions into a sequence and watch the dog perform them."
      }
    },
    {
      "type": "image",
      "sectionTitle": {
        "zh": "多关节动作与声光内容",
        "en": "Jointed movement, lights and music"
      },
      "image": "https://www.yaoshuntoys.com/media/products-q92/9901/de2c3e9e2cb3.webp",
      "text": {
        "zh": "资料列有多关节动作、百科早教内容、灯光和音乐。机身尺寸22 × 12 × 21 cm，盒面标注3岁及以上，点阵眼睛与关节位置可查看细节图。",
        "en": "Listed functions include multi-joint actions, educational content, lights and music. The body measures 22 × 12 × 21 cm, and the package is marked ages 3+. Detail images show the pixel-style eyes and joints."
      }
    },
    {
      "type": "image",
      "sectionTitle": {
        "zh": "配遥控器和USB充电线",
        "en": "Controller and USB cable"
      },
      "image": "https://www.yaoshuntoys.com/media/products-q92/9901/1a300416b13e.webp",
      "text": {
        "zh": "套装包含智能狗一只、遥控器一个、USB充电线一条。颜色资料列有紫色、蓝色、黄色和青色，具体出货配色可按货号9901核对。",
        "en": "The set includes one robot dog, one controller and one USB charging cable. Listed colors are purple, blue, yellow and cyan; confirm the supplied color against model 9901."
      }
    }
