  "productDetails": [
    {
      "type": "image",
      "sectionTitle": {
        "zh": "展开踢球，结束后折叠",
        "en": "A folding goal for football play"
      },
      "image": "https://www.yaoshuntoys.com/media/products-q92/WT6617/9742d9837c8d.webp",
      "text": {
        "zh": "这款球门采用折叠结构，展开后可以作为射门目标。活动结束后收起球和球网，再按产品结构折叠，便于整理游戏区域。",
        "en": "Open the folding goal for shooting practice. After play, collect the ball, arrange the net and fold the frame following its construction to clear the play area."
      }
    },
    {
      "type": "image",
      "sectionTitle": {
        "zh": "展开尺寸与配球",
        "en": "Open dimensions and ball"
      },
      "image": "https://www.yaoshuntoys.com/media/products-q92/WT6617/10b55e5e89b0.webp",
      "text": {
        "zh": "球门尺寸83.5 × 60 × 60 cm，配球直径16 cm。尺寸较紧凑，可以按这个占地范围规划位置，同时给前方的踢球动作留出距离。",
        "en": "The goal measures 83.5 × 60 × 60 cm and the ball is 16 cm in diameter. Use these dimensions to plan its position, with extra space in front for kicking."
      }
    },
    {
      "type": "image",
      "sectionTitle": {
        "zh": "六根管件，配球网和固定件",
        "en": "Six frame tubes, net and fixing pieces"
      },
      "image": "https://www.yaoshuntoys.com/media/products-q92/WT6617/b9fb01b878f8.webp",
      "text": {
        "zh": "配件图列出两根A管、四根B管、八个转角接头、一张球网、一个足球、一支打气筒和四根地钉。包装图标注75.5 × 6 × 16 cm，球门本身的83.5 × 60 × 60 cm另列。",
        "en": "The component diagram lists two A tubes, four B tubes, eight corner joints, one net, one ball, one pump and four stakes. The package measures 75.5 × 6 × 16 cm. The goal itself measures 83.5 × 60 × 60 cm."
      }
    }
  ],
