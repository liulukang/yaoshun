  "productDetails": [
    {
      "type": "image",
      "sectionTitle": {
        "zh": "一个支架布置几种目标",
        "en": "Several targets on one floating frame"
      },
      "image": "https://www.yaoshuntoys.com/media/products-q92/LYB008U/30743479eac1.webp",
      "text": {
        "zh": "投掷靶口、篮球圈和两侧挂钩组合在同一支架上。可以围绕不同目标安排投球和套圈轮次，也可以先选一个目标，逐步调整投掷距离。",
        "en": "A target opening, basketball hoop and side hooks share the same floating frame. Organize rounds around different targets, or start with one and adjust the throwing distance."
      }
    },
    {
      "type": "image",
      "sectionTitle": {
        "zh": "十二个套圈，四种颜色",
        "en": "Twelve rings in four colors"
      },
      "image": "https://www.yaoshuntoys.com/media/products-q92/LYB008U/2f84c7cc7317.webp",
      "text": {
        "zh": "配件图展示四种颜色共十二个套圈，并配一个红色手动打气筒。套圈可以按颜色分给不同参与者，便于区分各自的投掷结果。",
        "en": "The accessories image shows twelve rings in four colors and a red hand pump. Divide the rings by color so players can tell their throws apart."
      }
    },
    {
      "type": "image",
      "sectionTitle": {
        "zh": "按四合一版本核对",
        "en": "The 4-in-1 version"
      },
      "image": "https://www.yaoshuntoys.com/media/products-q92/LYB008U/7cfcb4fad216.webp",
      "text": {
        "zh": "LYB008U为四合一水上运动款，原表手提盒尺寸为41 × 13 × 33.5 cm。不同LYB008型号的配件不同，选购时按货号核对；水上活动需有人照看。",
        "en": "LYB008U is the 4-in-1 pool version. The supplied table lists a 41 × 13 × 33.5 cm carry box. Accessories differ across LYB008 models, so confirm the model when ordering. Pool activities require supervision."
      }
    }
  ],
