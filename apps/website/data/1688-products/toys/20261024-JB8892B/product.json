  "productDetails": [
    {
      "type": "image",
      "sectionTitle": {
        "zh": "从射门换到投篮",
        "en": "Switch between football and basketball"
      },
      "image": "https://www.yaoshuntoys.com/media/products-q92/JB8892B/7da3615d7a49.webp",
      "text": {
        "zh": "下方球门与上方篮球圈把两种球类游戏放在同一套结构上。可以先踢球，再换篮球投篮；想换一种节奏时，还可以使用套圈目标。",
        "en": "The lower goal and upper hoop share one structure. Start with football, change to basketball, or use the ring-toss targets for a different throwing game."
      }
    },
    {
      "type": "image",
      "sectionTitle": {
        "zh": "高98 cm，底座79 × 49 cm",
        "en": "98 cm high, with a 79 × 49 cm base"
      },
      "image": "https://www.yaoshuntoys.com/media/products-q92/JB8892B/38b677a6e5be.webp",
      "text": {
        "zh": "支架高98 cm，底部宽79 cm、深49 cm。篮球圈位于球门上方，套圈杆设置在底座两侧。安排玩法时，可分别留出正面射门和侧面套圈的位置。",
        "en": "The frame is 98 cm high, with a base 79 cm wide and 49 cm deep. The hoop is above the goal, and ring-toss posts stand at the sides of the base. Leave front and side space for the different games."
      }
    },
    {
      "type": "image",
      "sectionTitle": {
        "zh": "一只篮球、一只足球、三个套圈",
        "en": "One basketball, one football and three rings"
      },
      "image": "https://www.yaoshuntoys.com/media/products-q92/JB8892B/fde82da9897d.webp",
      "text": {
        "zh": "配件包括直径10 cm篮球一只、直径14 cm足球一只、直径13.5 cm绿色套圈三个，以及长16 cm打气筒。原包装图明确标注彩盒62 × 5.8 × 31 cm。",
        "en": "Contents shown are one 10 cm basketball, one 14 cm football, three green 13.5 cm rings and a 16 cm pump. The original package image labels the color box at 62 × 5.8 × 31 cm."
      }
    }
