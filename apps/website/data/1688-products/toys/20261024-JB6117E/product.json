  "productDetails": [
    {
      "type": "image",
      "sectionTitle": {
        "zh": "抛球挂杆，套圈瞄准",
        "en": "Two ways to aim"
      },
      "image": "https://www.yaoshuntoys.com/media/products-q92/JB6117E/255b6290793e.webp",
      "text": {
        "zh": "连接绳抛球用于阶梯抛球游戏，套圈用于另一种投掷方式。可以先约定投掷线，再轮流尝试把球挂上横杆、把套圈投向目标。",
        "en": "Use the tethered balls for ladder toss and the rings for ring toss. Set a throwing line, then take turns trying to land the balls on a rung or a ring on its target."
      }
    },
    {
      "type": "image",
      "sectionTitle": {
        "zh": "三层横杆，高83 cm",
        "en": "Three rungs, 83 cm high"
      },
      "image": "https://www.yaoshuntoys.com/media/products-q92/JB6117E/04d54baa4c03.webp",
      "text": {
        "zh": "支架高83 cm、宽48 cm、深39 cm，设有三层横杆。四组连接绳抛球分为红蓝两色，可以约定不同横杆的分值，轮流投掷。",
        "en": "The frame is 83 cm high, 48 cm wide and 39 cm deep, with three rungs. Four tethered-ball pairs come in red and blue. Assign points to the rungs and take turns throwing."
      }
    },
    {
      "type": "image",
      "sectionTitle": {
        "zh": "四个套圈与四组抛球",
        "en": "Four rings and four toss-ball pairs"
      },
      "image": "https://www.yaoshuntoys.com/media/products-q92/JB6117E/1cd64cd06139.webp",
      "text": {
        "zh": "套圈共四个，粉色和绿色各两个，直径13.5 cm。另配四组连接绳抛球。原包装图标注彩盒宽49 cm、高27.5 cm、厚6.2 cm，以这组明确标注更新包装参考。",
        "en": "There are four 13.5 cm rings, two pink and two green, plus four tethered-ball pairs. The original package image labels the box as 49 cm wide, 27.5 cm high and 6.2 cm deep."
      }
    }
  ],
