  "productDetails": [
    {
      "type": "image",
      "sectionTitle": {
        "zh": "手持与挂脖两种使用方式",
        "en": "Handheld or worn with a strap"
      },
      "image": "https://www.yaoshuntoys.com/media/products-q92/FC-6655B1/395910c3f601.webp",
      "text": {
        "zh": "这款小风扇以手持和挂脖为使用方式，适合在通勤、排队或外出时随身携带。机身把扇头与手柄连成一体，圆形控制按键位于手柄上。",
        "en": "This portable fan can be held or worn with a neck strap for carrying on commutes, while queuing or when out. The fan head and handle form one body, with a round control button on the handle."
      }
    },
    {
      "type": "image",
      "sectionTitle": {
        "zh": "无刷电机与多种扇头配色",
        "en": "Brushless motor and pictured colors"
      },
      "image": "https://www.yaoshuntoys.com/media/products-q92/FC-6655B1/d9814dc262ed.webp",
      "text": {
        "zh": "配置高速无刷电机，图片展示棕色、米白绿色与玫红色扇头，手柄带反光表面。不同颜色的实际供货情况可在选款时核对。",
        "en": "The fan uses a high-speed brushless motor. Pictured versions have brown, cream-green and magenta fan heads with reflective handles. Confirm the available color when selecting the model."
      }
    },
    {
      "type": "image",
      "sectionTitle": {
        "zh": "1800 mAh电池，配USB线",
        "en": "1,800 mAh battery and USB cable"
      },
      "image": "https://www.yaoshuntoys.com/media/products-q92/FC-6655B1/100c4ffb1167.webp",
      "text": {
        "zh": "电池为18650锂电池，容量1800 mAh，配USB充电线。包装尺寸5.9 × 4.8 × 16.6 cm；资料未给出风速档位、充电时间或续航时长。",
        "en": "The fan uses an 18650 lithium battery rated at 1,800 mAh, with a USB charging cable included. Package dimensions are 5.9 × 4.8 × 16.6 cm. Speed settings, charging time and run time are not specified."
      }
    }
  ],
