  "videos": [],
  "productDetails": [
    {
      "type": "image",
      "sectionTitle": {
        "zh": "把投篮练习单独拿出来",
        "en": "A dedicated basketball set"
      },
      "image": "https://www.yaoshuntoys.com/media/products-q92/JB5038D/5dbe095cf285.webp",
      "text": {
        "zh": "这款以篮球投篮为主，不混入其他运动项目。支架、篮圈和篮板组成完整的投篮目标，可以用来练习近距离投球，也可以安排轮流投篮的小比赛。",
        "en": "This set focuses on basketball. Its frame, hoop and backboard provide a target for close-range shooting and taking turns in a simple shooting game."
      }
    },
    {
      "type": "image",
      "sectionTitle": {
        "zh": "高114 cm，底座42 × 49 cm",
        "en": "114 cm high, with a 42 × 49 cm base"
      },
      "image": "https://www.yaoshuntoys.com/media/products-q92/JB5038D/6b83914ca206.webp",
      "text": {
        "zh": "支架整体高114 cm，底座宽42 cm、深49 cm。篮圈下方有倾斜球网，支架采用管件与转角接头连接。摆放时给前方留出投篮和捡球距离。",
        "en": "The frame is 114 cm high, with a base 42 cm wide and 49 cm deep. An inclined net sits below the hoop, and the frame uses tubes and corner joints. Allow shooting and ball-retrieval space in front."
      }
    },
    {
      "type": "image",
      "sectionTitle": {
        "zh": "两个12 cm篮球与打气筒",
        "en": "Two 12 cm basketballs and a pump"
      },
      "image": "https://www.yaoshuntoys.com/media/products-q92/JB5038D/3a81fbb8534d.webp",
      "text": {
        "zh": "套装配两个直径12 cm的篮球和一支长16 cm的打气筒。可轮流使用两只球，打气筒单独收好。彩盒尺寸53.8 × 7 × 38.8 cm，型号JB5038D。",
        "en": "The set has two basketballs measuring 12 cm in diameter and a 16 cm pump. Keep the pump with the set between uses. The color box measures 53.8 × 7 × 38.8 cm; model JB5038D."
      }
    }
  ],
