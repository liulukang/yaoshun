  "productDetails": [
    {
      "type": "image",
      "sectionTitle": {
        "zh": "为射门准备一个目标",
        "en": "A goal for shooting practice"
      },
      "image": "https://www.yaoshuntoys.com/media/products-q92/WT6613/2cb5fe648111.webp",
      "text": {
        "zh": "WT6613采用白色管架与球网结构，适合安排近距离射门和小范围踢球游戏。可以单人练习，也可以轮流射门、记录进球次数。",
        "en": "WT6613 uses a white tubular frame and net for close-range shooting and small football games. Practise alone or take turns counting successful shots."
      }
    },
    {
      "type": "image",
      "sectionTitle": {
        "zh": "球门与足球尺寸",
        "en": "Goal and ball dimensions"
      },
      "image": "https://www.yaoshuntoys.com/media/products-q92/WT6613/8dc4727f39c3.webp",
      "text": {
        "zh": "组装后的球门尺寸为120 × 63 × 63 cm，足球直径16 cm。使用前按球门宽度安排位置，并在前方预留踢球和捡球的空间。",
        "en": "The assembled goal measures 120 × 63 × 63 cm, and the football is 16 cm in diameter. Allow room in front of the goal for kicking and retrieving the ball."
      }
    },
    {
      "type": "image",
      "sectionTitle": {
        "zh": "查看管架连接与球网",
        "en": "Frame joints and net"
      },
      "image": "https://www.yaoshuntoys.com/media/products-q92/WT6613/b6cd5cf43833.webp",
      "text": {
        "zh": "细节图展示白色管件、黑色转角接头和打结球网。组装后检查接头是否到位、球网是否整理好，再开始使用；单品以彩盒包装。",
        "en": "The detail image shows white tubes, black corner joints and a knotted net. Check the connections and arrange the net before play. The set is supplied in a color box."
      }
    }
  ],
