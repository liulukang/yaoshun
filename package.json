{
  "name": "yaoshun",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @yaoshun/website --filter @yaoshun/admin --filter @yaoshun/server dev",
    "dev:website": "pnpm --filter @yaoshun/website dev",
    "dev:admin": "pnpm --filter @yaoshun/admin dev",
    "dev:server": "pnpm --filter @yaoshun/server dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck"
  }
}
